generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model WatchItem {
  id         String        @id @default(cuid())
  type       String
  title      String
  paramsJson String
  memo       String?
  enabled    Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  results    QueryResult[]
  alertRule  AlertRule?

  @@index([type])
  @@index([enabled])
}

model QueryResult {
  id          String     @id @default(cuid())
  watchItemId String?
  type        String
  status      String
  source      String?
  checkedAt   DateTime   @default(now())
  summary     String?
  officialUrl String?
  resultJson  String
  errorCode   String?
  errorText   String?
  createdAt   DateTime   @default(now())
  watchItem   WatchItem? @relation(fields: [watchItemId], references: [id], onDelete: SetNull)

  @@index([watchItemId])
  @@index([type])
  @@index([status])
  @@index([checkedAt])
}
model AlertRule {
  id                    String   @id @default(cuid())
  watchItemId           String   @unique
  channel               String   @default("telegram")
  conditionJson         String
  enabled               Boolean  @default(false)
  outboundOptIn         Boolean  @default(false)
  configVersion         Int      @default(1)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  lastProviderRunAt     DateTime?

  latestOutcome         String   @default("never")
  latestOutcomeAt       DateTime?
  latestOutcomeCode     String?

  baselineState         String   @default("never")
  baselineFingerprint   String?
  baselineTransitionSeq Int      @default(0)
  baselineAt            DateTime?

  deliveryState         String   @default("never")
  attemptId             String?
  attemptRunId          String?
  attemptFingerprint    String?
  attemptTransitionSeq  Int?
  attemptResultId       String?
  attemptResultType     String?
  lastAttemptAt         DateTime?
  terminalAt            DateTime?
  deliveryCode          String?

  watchItem             WatchItem @relation(fields: [watchItemId], references: [id], onDelete: Restrict)

  @@index([enabled, lastProviderRunAt, createdAt, id])
}
